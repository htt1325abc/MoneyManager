<resources>
    <style name="Base.Theme.MoneyManager"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/ledger_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ledger_income</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/ledger_background</item>
        <item name="colorSurface">@color/ledger_surface</item>
        <item name="colorOnSurface">@color/ledger_text</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ledger_surface</item>
    </style>

    <style name="Theme.MoneyManager"
        parent="Base.Theme.MoneyManager" />

    <!-- Kiểu card cơ sở dùng chung cho toàn bộ ứng dụng. -->
    <style name="Widget.MoneyManager.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ledger_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ledger_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Các biến thể chỉ ghi đè những thuộc tính khác với card cơ sở. -->
    <style name="Widget.MoneyManager.Card.Balance" parent="Widget.MoneyManager.Card">
        <item name="cardBackgroundColor">@color/ledger_navy</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.MoneyManager.Card.Income" parent="Widget.MoneyManager.Card">
        <item name="cardBackgroundColor">@color/ledger_income_soft</item>
        <item name="strokeColor">@color/ledger_income_soft</item>
    </style>

    <style name="Widget.MoneyManager.Card.Expense" parent="Widget.MoneyManager.Card">
        <item name="cardBackgroundColor">@color/ledger_expense_soft</item>
        <item name="strokeColor">@color/ledger_expense_soft</item>
    </style>

    <style name="TextAppearance.MoneyManager.Amount" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MoneyManager.HeroAmount" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
